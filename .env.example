# Non-secret local development configuration. Copy to ignored .env.
PAPERBRIDGE_PORT=/dev/cu.usbmodem101
PAPERBRIDGE_DEVICE_ID=paperbridge-dev-001
PAPERBRIDGE_PRINTER_HOST=192.168.4.87
PAPERBRIDGE_PRINTER_PORT=9100
PAPERBRIDGE_MQTT_HOST=192.0.2.1
PAPERBRIDGE_MQTT_PORT=1883
PAPERBRIDGE_MQTT_USERNAME=paperbridge-dev-001
# Keep false for local Mosquitto. TLS requires a local PEM CA file and the broker DNS name.
PAPERBRIDGE_MQTT_TLS_ENABLED=false
PAPERBRIDGE_MQTT_TLS_CA_CERTIFICATE_FILE=
PAPERBRIDGE_MQTT_TLS_SERVER_HOSTNAME=
# Opt in the provisioned device before REST/MCP/MQTT jobs may cut paper.
PAPERBRIDGE_MQTT_ALLOW_CUT=false
PAPERBRIDGE_API_HOST=127.0.0.1
PAPERBRIDGE_API_PORT=3000
PAPERBRIDGE_JOB_RESULT_TIMEOUT_MS=15000
