{
  "name": "@paperbridge/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && bun build src/server.ts src/main.ts --target=node --format=esm --external=sharp --outdir=dist",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "start": "node --import tsx src/server.ts",
    "start:production": "node dist/server.js",
    "mqtt:probe": "node --import tsx src/main.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@paperbridge/protocol": "workspace:*",
    "mqtt": "^5.14.1",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^24.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
