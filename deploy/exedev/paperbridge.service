[Unit]
Description=Paperbridge private API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=paperbridge
Group=paperbridge
WorkingDirectory=/opt/paperbridge/current
Environment=HOME=/var/empty
Environment=MISE_DATA_DIR=/opt/paperbridge/current/.mise
EnvironmentFile=/etc/paperbridge/paperbridge.env
ExecStart=/opt/paperbridge/current/deploy/exedev/run-node.sh apps/api/src/server.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/paperbridge/current/.mise
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
