{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperbridge.dev/schemas/print-job.v1.schema.json",
  "title": "Paperbridge semantic print job v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "device_id", "created_at", "content"],
  "properties": {
    "schema_version": { "const": "1" },
    "job_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "device_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "created_at": { "type": "string", "minLength": 1, "maxLength": 64 },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "blocks"],
      "properties": {
        "kind": { "const": "receipt" },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/block" }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[ -~]+$" },
        "align": { "enum": ["left", "center", "right"], "default": "left" },
        "bold": { "type": "boolean", "default": false },
        "underline": { "type": "boolean", "default": false },
        "width_multiplier": { "type": "integer", "minimum": 1, "maximum": 2, "default": 1 },
        "height_multiplier": { "type": "integer", "minimum": 1, "maximum": 2, "default": 1 }
      }
    },
    "qr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "data"],
      "properties": {
        "type": { "const": "qr" },
        "data": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[ -~]+$" },
        "module_size": { "type": "integer", "minimum": 1, "maximum": 8, "default": 3 }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "mime_type", "data_base64"],
      "properties": {
        "type": { "const": "image" },
        "mime_type": { "enum": ["image/png", "image/jpeg"] },
        "data_base64": { "type": "string", "minLength": 4, "maxLength": 512, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" }
      }
    },
    "raster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "width", "height", "data_base64"],
      "properties": {
        "type": { "const": "raster" },
        "width": { "type": "integer", "minimum": 1, "maximum": 128 },
        "height": { "type": "integer", "minimum": 1, "maximum": 24 },
        "data_base64": { "type": "string", "minLength": 4, "maxLength": 512, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" }
      }
    },
    "feed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "lines"],
      "properties": {
        "type": { "const": "feed" },
        "lines": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "character"],
      "properties": {
        "type": { "const": "rule" },
        "character": { "type": "string", "minLength": 1, "maxLength": 1, "pattern": "^[ -~]$" }
      }
    },
    "cut": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "mode"],
      "properties": {
        "type": { "const": "cut" },
        "mode": { "const": "partial" }
      }
    },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/text" },
        { "$ref": "#/$defs/qr" },
        { "$ref": "#/$defs/image" },
        { "$ref": "#/$defs/raster" },
        { "$ref": "#/$defs/feed" },
        { "$ref": "#/$defs/rule" },
        { "$ref": "#/$defs/cut" }
      ]
    }
  }
}
