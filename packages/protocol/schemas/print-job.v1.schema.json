{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperbridge.dev/schemas/print-job.v1.schema.json",
  "title": "Paperbridge semantic print job v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "device_id", "created_at", "content"],
  "properties": {
    "schema_version": { "const": "1" },
    "job_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "device_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "created_at": { "type": "string", "minLength": 1, "maxLength": 64 },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "blocks"],
      "properties": {
        "kind": { "const": "receipt" },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/block" }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[ -~]+$" }
      }
    },
    "feed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "lines"],
      "properties": {
        "type": { "const": "feed" },
        "lines": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "character"],
      "properties": {
        "type": { "const": "rule" },
        "character": { "type": "string", "minLength": 1, "maxLength": 1, "pattern": "^[ -~]$" }
      }
    },
    "cut": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "mode"],
      "properties": {
        "type": { "const": "cut" },
        "mode": { "const": "partial" }
      }
    },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/text" },
        { "$ref": "#/$defs/feed" },
        { "$ref": "#/$defs/rule" },
        { "$ref": "#/$defs/cut" }
      ]
    }
  }
}
